#!/usr/bin/env bash
# v6 pre-commit gate — absorbs v5 SG.R44.1 8 mechanical commands + lint/test/plugin-load
#
# Gap #1 fix (R102): previous sequence ran `bun run check` (oxfmt --check) BEFORE
# bun test, then `bun run format` (oxfmt --write) could run separately. This is
# structurally fragile: oxfmt --write can mutate source files and break tests
# (anchor drift, comment removal, etc.) but the gate PASSED because bun test ran
# before the reformat.
#
# New sequence: format --write FIRST (mutate any drift), re-stage, then bun test
# (verify tests still pass). This catches anchor drift deterministically.
#
# Mechanical checks (v5 SG.R44.1 commands 1-8):
#   1. git status --porcelain  (working tree status; informational only)
#   2. SKILL.md drift (files newer than SKILL.md)
#   3. stale backup/tmp files (*.backup-*, *.swp, *.orig)
#   4. Husky configuration present and wired
#   5. Orphan pm-manager-approved GH issues (informational)
#   6. scripts/verify-plugin-load.mjs (4-gate runtime probe)
#   7. format --write + re-stage + bun test (anchor drift check)
#   8. bun run lint + bun run typecheck
#
# Failure of any check blocks the commit.
# Use `git commit --no-verify` to skip (escape hatch for lead-direct emergencies).
set -e
cd "$(git rev-parse --show-toplevel)"

echo "🔍 v6 pre-commit: mechanical hygiene..."
echo ""

# 1. git status (informational only — dirty working tree is fine if it's the round's work)
echo "[1/8] git status --porcelain"
git status --porcelain | head -20 || true
echo ""

# 2. SKILL.md drift check (find .opencode/ .md newer than SKILL.md)
echo "[2/8] SKILL.md drift (newer files in .opencode/skills/)"
NEWER=$(find .opencode/skills/ -name '*.md' -newer .opencode/skills/team-dev-loop/SKILL.md 2>/dev/null || true)
if [ -n "$NEWER" ]; then
  echo "  ⚠️  Files newer than SKILL.md:"
  echo "$NEWER"
  echo "  (Informational — may indicate drift between SKILL.md and other skill docs)"
fi
echo ""

# 3. Stale backup/tmp files
echo "[3/8] stale backup/tmp files"
STALE=$(find . -maxdepth 4 \( -name '*.backup-*' -o -name '*.swp' -o -name '*.orig' -o -name '*.tmp.*' \) 2>/dev/null | grep -v node_modules | grep -v .git || true)
if [ -n "$STALE" ]; then
  echo "  ❌ Stale files found:"
  echo "$STALE"
  exit 1
fi
echo "  ✓ no stale files"
echo ""

# 4. Husky configuration
echo "[4/8] Husky configuration"
[ -f .husky/pre-commit ] || { echo "  ❌ .husky/pre-commit missing"; exit 1; }
[ -d node_modules/husky ] || { echo "  ❌ node_modules/husky missing"; exit 1; }
HOOKS_PATH=$(git config --get core.hooksPath)
[ "$HOOKS_PATH" = ".husky" ] || { echo "  ❌ core.hooksPath != .husky (got: $HOOKS_PATH)"; exit 1; }
echo "  ✓ husky configured"
echo ""

# 5. Orphan pm-manager-approved GH issues (informational only — not blocking)
echo "[5/8] Orphan pm-manager-approved GH issues (informational)"
ORPHANS=$(gh issue list --label pm-manager-approved --state open --limit 50 2>/dev/null || echo "")
if [ -n "$ORPHANS" ]; then
  echo "  ⚠️  Open pm-manager-approved issues:"
  echo "$ORPHANS"
fi
echo ""

# 6. Plugin load verification (4-gate runtime probe)
echo "[6/8] verify-plugin-load.mjs"
node scripts/verify-plugin-load.mjs >/dev/null || { echo "  ❌ plugin load FAIL"; exit 1; }
echo "  ✓ plugin load PASS"
echo ""

# 7. Gap #1 fix: format --write FIRST, re-stage, then bun test
echo "[7/8] format --write + re-stage + bun test (anchor drift check)"
echo "  Running oxfmt --write src/ to auto-format any drift..."
bunx oxfmt --write src/ >/dev/null 2>&1 || true
git add -u src/ || true
bun test >/dev/null 2>&1 || { echo "  ❌ bun test FAILED after format --write (anchor drift?)"; bun test 2>&1 | tail -40; exit 1; }
echo "  ✓ test PASS (no anchor drift after format --write)"
echo ""

# 8. lint + typecheck (without format — already done in #7)
echo "[8/8] bun run lint + typecheck"
bun run lint >/dev/null 2>&1 || { echo "  ❌ bun run lint failed"; bun run lint 2>&1 | tail -40; exit 1; }
echo "  ✓ lint PASS"
bun run typecheck >/dev/null 2>&1 || { echo "  ❌ bun run typecheck failed"; bun run typecheck 2>&1 | tail -40; exit 1; }
echo "  ✓ typecheck PASS"
echo ""

echo "✅ v6 pre-commit: ALL 8 CHECKS PASS"